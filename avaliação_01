# sistema de notas de alunos

notas = []

print('🏧  --- Bem-vindo ao sistema de notas ---')

turma = []

qtd = int(input("Quantos alunos? "))

i = 0
while i < qtd:
    print("\nAluno", i+1)
    
    nome = input("Nome: ")
    
    n1 = float(input("Nota 1: "))
    n2 = float(input("Nota 2: "))
    n3 = float(input("Nota 3: "))
    
    media = (n1 + n2 + n3) / 3
    
    if media >= 7:
        situacao = "Aprovado"
    elif media >= 5:
        situacao = "Recuperacao"
    else:
        situacao = "Reprovado"
    
    # guardando tudo
    aluno = [nome, n1, n2, n3, media, situacao]
    turma.append(aluno)
    
    i = i + 1

print("\n--- RESULTADO ---")

for aluno in turma:
    print("\nNome:", aluno[0])
    print("Notas:", aluno[1], aluno[2], aluno[3])
    print("Media:", aluno[4])
    print("Situacao:", aluno[5])